{
  "packages": [
    "nodejs@26",
    "mkcert@latest",
    "openssl@latest",
    "xh@latest",
    "mitmproxy@latest",
    "jaq@latest",
    "ducker@latest",
    "pgcli@latest",
    "github:dagger/nix/4a39fb35b724a8f85c254fa1513fa0ffc17162e7#packages.x86_64-linux.dagger",
    "nixos-anywhere@latest",
    "nix-prefetch-docker@latest",
    "skopeo@latest",
    "prefetch-npm-deps@latest",
    "ragenix@latest",
    "cacert@latest",
    "nixfmt@latest",
    "nixd@latest",
    "garage@latest",
    "oxigraph@latest"
  ],
  "env": {
    "_EXPERIMENTAL_DAGGER_RUNNER_HOST": "docker-container://dagger-engine-v0.21.9"
  },
  "shell": {
    "init_hook": [
      "export CAROOT=\"$(mkcert -CAROOT)\"",
      "export SSL_CERT_FILE=$CAROOT/rootCA.pem",
      "alias jq='jaq'"
    ],
    "scripts": {
      "up": "make up",
      "down": "make down",
      "seed": "node packages/repl/cmd.ts -- seed-env",
      "local-css": [
        "set -euo pipefail",
        "ROOT=\"$PWD\"",
        "CSS_DIR=\"${CSS_DIR:-$ROOT/../CommunitySolidServer}\"",
        "if [ ! -f \"$CSS_DIR/package.json\" ]; then echo \"CSS checkout not found at $CSS_DIR (set CSS_DIR=/path/to/CommunitySolidServer)\" >&2; exit 1; fi",
        "export NPM_CONFIG_PREFIX=\"${NPM_CONFIG_PREFIX:-$HOME/.npm-global}\"",
        "mkdir -p \"$NPM_CONFIG_PREFIX\"",
        "echo \"Building and linking local CSS from $CSS_DIR\"",
        "cd \"$CSS_DIR\"",
        "npm run build",
        "npm link",
        "cd \"$ROOT\"",
        "npm link @solid/community-server",
        "npm link @solid/community-server -w @elfpavlik/sai-components",
        "node -e \"console.log('CSS ->', require.resolve('@solid/community-server/package.json'))\""
      ],
      "fork-css": [
        "set -euo pipefail",
        "ROOT=\"$PWD\"",
        "rm -rf \"$ROOT/packages/components/node_modules/@solid/community-server\"",
        "cd \"$ROOT\"",
        "npm update @solid/community-server",
        "node -e \"const l=require('./package-lock.json');const p=require('@solid/community-server/package.json');console.log('CSS', p.version, '->', require.resolve('@solid/community-server/package.json'));console.log('lock ->', l.packages['node_modules/@solid/community-server'].resolved)\""
      ]
    }
  }
}
