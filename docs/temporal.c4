  dynamic view admin-invitation-send {
    title: 'Invitation / Dan as YoYo admin invites Kim'

    include Kim, YoYo, Dan
    include Kim.AUI, Kim.UAS, Kim.UAS.UiApi, Kim.UAS.Temporal, Kim.UAS.WebhookReceiver, Kim.UAS.Discovery, Kim.Registry, YoYo.Registry, YoYo.UAS.Discovery, YoYo.UAS.WebhookReceiver, YoYo.UAS.Temporal, YoYo.UAS, Dan.UAS, Dan.UAS.Discovery, Dan.UAS.WebhookReceiver, Dan.UAS.UiApi, Dan.AUI

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    style Kim {
      color: sky
    }

    Dan.AUI -> Dan.UAS.UiApi 'Connect to the notifications stream' {
        notes'''
          #### Connect to the notifications stream
          >[!NOTE]
          >invitation.test.ts > admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > response stays alive for streaming

          ```http
          GET https://auth/.sai/events
          Accept: application/x-ndjson
          ```
        '''
    }
    Dan.AUI -> Dan.UAS.UiApi 'POST (RPC) createInvitation' {
        notes'''
          #### POST (RPC) createInvitation
          >[!NOTE]
          >invitation.test.ts > admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=4f8fe6e4-4a5a-4318-93f6-d8645778fc28
          ```

          ```json
          [
            {
              "request": {
                "_tag": "CreateInvitation",
                "label": "Kim",
                "note": "Some note",
                "context": "https://id/yoyo"
              }
            }
          ]
          ```
        '''
    }
    Dan.UAS.Discovery -> YoYo.UAS.Discovery 'discover org registry set' {
        navigateTo org-registry-set-discovery
        notes'''
          #### discover org registry set
          >[!NOTE]
          >invitation.test.ts > admin

          [org-registry-set-discovery](../org-registry-set-discovery/?dynamic=sequence)

