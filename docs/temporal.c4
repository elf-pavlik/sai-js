  dynamic view authorization-data-app {
    title: 'Authorization data (app)'

    include Alice, App, Common
    include App.CID, App.UI, Alice.AUI, Alice.UAS, Alice.Registry, Alice.Data, Common.Shapetrees

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    style Common {
      color: slate
    }

    App.UI -> Alice.AUI 'redirect'
    Alice.AUI -> Alice.UAS 'POST (RPC) getAuthorizationData'
    Alice.UAS -> App.CID 'GET discover access needs'
    App.CID -> Alice.UAS '200 OK'
    Alice.UAS -> Alice.Data 'find relevant data registrations [Data]'
    Alice.Data -> Alice.UAS 'list'
    Alice.UAS -> Alice.Registry 'find relevant grants to relevant data registrations [Grant]'
    Alice.Registry -> Alice.UAS 'list'
    Alice.UAS -> App.CID 'GET access needs descriptions'
    App.CID -> Alice.UAS '200 OK'
    Alice.UAS -> Common.Shapetrees 'GET shapetrees descriptions'
    Common.Shapetrees -> Alice.UAS '200 OK'
    Alice.UAS -> Alice.AUI 'OK authorization data'
    Alice.AUI .overview Alice.UAS 'authorize' {
        navigateTo authorization
        notes'''
          after user is done with authorization screen
        '''
    }
    Alice.AUI -> App.UI 'redirect back'
  }

  dynamic view authorization {
    title: 'Authorization'

    include Bob, App
    include Bob.AUI, Bob.UAS, Bob.ActivityWebhookHandler, Bob.Registry, Bob.Temporal, Bob.Worker

    style Bob {
      color: indigo
    }

    style App {
      color: gray
    }

    App -> Bob.AUI 'redirect'
    Bob.AUI .overview Bob.UAS 'get authorization data' {
        navigateTo authorization-data-app
        notes'''
          needed to render the authorization screen
        '''
    }
    Bob.AUI -> Bob.UAS 'POST (RPC) authorization' {
        notes'''
          uses cookie session with User Authorization Server
        '''
    }
    Bob.UAS -> Bob.Registry 'create Access Authorization [Authorization]'
    Bob.UAS -> Bob.Registry '(ensure) application registration if does not exist [Agent]'
    Bob.UAS -> Bob.Registry 'PUT authorizationRecorded activity [Activity]'
    Bob.UAS -> Bob.AUI '202 Accepted'
    Bob.Registry -> Bob.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Bob.ActivityWebhookHandler -> Bob.Temporal 'start per-grantee consumer (processGranteeActivities)'
    Bob.Temporal -> Bob.ActivityWebhookHandler 'OK'
    Bob.Temporal -> Bob.Worker '(workflow) run processGranteeActivities'
    parallel {
      Bob.Worker -> Bob.Registry '(activity) create grants [Grant]' {
          notes'''
            durable execution should ensure consistency
          '''
      }
      Bob.Registry -> Bob.Worker 'OK'
    }
    Bob.Worker -> Bob.Registry '(activity) create activityCompleted [Activity]'
    Bob.ActivityWebhookHandler -> Bob.AUI 'done'
    Bob.AUI -> App 'redirect back'
    App .overview Bob.UAS 'discover application registration' {
        navigateTo application-registration-discovery
    }
    App -> Bob.Registry 'GET Application Registration [Agent]'
    Bob.Registry -> App 'Application Registration'
  }

