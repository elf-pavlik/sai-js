    }
    Dan.UAS.UiApi -> YoYo.Registry 'find AdminAuthorization + last-admin guard' {
        notes'''
          #### find AdminAuthorization + last-admin guard
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          >[!TIP]
          > validation reads (R1 re-decision): admin-exists + the LAST-ADMIN
          > guard — the org must never end up adminless (error at RPC time);
          > the workflow re-checks via `syncAdminAcr`
        '''
    }
    Dan.UAS.UiApi -> YoYo.Registry 'PUT AdminAuthorizationRevoked activity [Activity]' {
        notes'''
          #### PUT AdminAuthorizationRevoked activity [Activity]
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `yoyo`

          >[!TIP]
          > `target` dropped — the revoked record's id rides `object.id`;
          > the object is the EXISTING AdminAuthorization (real-id embedded
          > projection at its real id — alive at write; the workflow DELETEs it)

          ```http
          PUT https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
            "type": ["Activity", "AdminAuthorizationRevoked"],
            "as:actor": "https://id/yoyo",
            "as:object": {
              "id": "https://registry/yoyo/authorization/9b6d4e5f-2a3b-4c8d-9e0f-1a2b3c4d5e6f",
