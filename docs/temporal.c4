specification {
  element security
  relationship overview {
    tail normal
  }
  relationship httpnotify
}

model {
  security ACME {
    component DelegationIssuance 'DelegationIssuance' 'auth'{
    }
    component WebhookSender 'WebhookSender' 'auth' {
    }
  }
  security Others {
    component WebhookReceiver 'WebhookReceiver' 'auth' {
    }
  }
  security Common {
    component Shapetrees 'Shapetrees' 'dir' {
    }
  }
  security Alice {
    component UAS 'User Authorization Server' 'auth' {
      component UiApi 'UI RPC+Events API' 'auth' {
      }
      component Temporal 'Temporal' {
      }
      component WebhookReceiver 'WebhookReceiver' 'auth' {
      }
      component Discovery 'Discovery' 'auth' {
      }
    }
    component WebhookSender 'WebhookSender' 'reg' {
    }
    component StreamingHTTPSender 'StreamingHTTPSender' 'reg' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Bob {
    component UAS 'User Authorization Server' 'auth' {
      component UiApi 'UI RPC+Events API' 'auth' {
      }
      component Temporal 'Temporal' {
      }
      component WebhookReceiver 'WebhookReceiver' 'auth' {
      }
      component Discovery 'Discovery' 'auth' {
      }
    }
    component WebhookSender 'WebhookSender' 'registry' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Kim {
    component UAS 'User Authorization Server' 'auth' {
      component UiApi 'UI RPC+Events API' 'auth' {
      }
      component Temporal 'Temporal' {
      }
      component WebhookReceiver 'WebhookReceiver' 'auth' {
      }
      component Discovery 'Discovery' 'auth' {
      }
    }
    component Registry 'Registry' 'registry' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Dan {
    component UAS 'User Authorization Server' 'auth' {
      component UiApi 'UI RPC+Events API' 'auth' {
      }
      component Temporal 'Temporal' {
      }
      component WebhookReceiver 'WebhookReceiver' 'auth' {
      }
      component Discovery 'Discovery' 'auth' {
      }
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security YoYo {
    component UAS 'User Authorization Server' 'auth' {
      component UiApi 'UI RPC+Events API' 'auth' {
      }
      component Temporal 'Temporal' {
      }
      component WebhookReceiver 'WebhookReceiver' 'auth' {
      }
      component Discovery 'Discovery' 'auth' {
      }
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
  }
  security Peers {
    component UAS 'User Authorization Server' 'auth' {
    }
  }
  security App {
    component StreamingHTTPReceiver 'StreamingHTTPReceiver' 'app' {
    }
    component UI 'App UI' 'app' {
    }
    component CID 'Controlled Identifier' 'app' {
    }
  }
}

views {
  dynamic view reciprocal-registration-update {
    title: 'Reciprocal registration update'

    include Alice, ACME
    include DelegationIssuance, ACME.WebhookSender, Alice.UAS, Alice.UAS.Temporal, Alice.UAS.WebhookReceiver, Alice.Registry

    style Alice {
      color: green
    }

    style ACME {
      color: indigo
    }

    ACME.WebhookSender -> Alice.UAS.WebhookReceiver 'notify'
    Alice.UAS.WebhookReceiver -> Alice.Registry 'PUT delegatedGrantsUpdated activity [Activity]'
    Alice.UAS.WebhookReceiver -> ACME.WebhookSender 'OK'
    Alice.Registry -> Alice.UAS.WebhookReceiver 'notify Add activity (subscription webhook) [Activity]'
    Alice.UAS.WebhookReceiver -> Alice.UAS.Temporal 'start updateDelegatedGrants workflow' {
        notes'''
          #### start updateDelegatedGrants workflow
          >[!NOTE]
          >reciprocal-webhook.test.ts > emits pending and done events for the delegatedGrantsUpdated activity

          >[!TIP]
          >gRPC

          ---

          ```http
          HTTP/1.1 200 OK
          ```
        '''
    }
    Alice.UAS.Temporal -> Alice.UAS.Temporal '(workflow) run updateDelegatedGrants'
    Alice.UAS.Temporal -> Alice.Registry 'find affected authorizations [Authorization]'
    parallel {
      Alice.UAS.Temporal -> Alice.UAS.Temporal '(child workflows) start update grants workflows'
      Alice.UAS.Temporal -> Alice.UAS.Temporal 'run update grants workflow'
      Alice.UAS.Temporal -> DelegationIssuance '(activity) register delegation with resource owner'
      DelegationIssuance -> Alice.UAS.Temporal 'OK'
      Alice.UAS.Temporal -> Alice.Registry '(activity) update registration [Agent]'
      Alice.Registry -> Alice.UAS.Temporal 'OK'
    }
    Alice.UAS.Temporal -> Alice.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view application-registration-discovery {
    title: 'Discovery / Application Registration'

    include Alice, App
    include Alice.UAS, Alice.UAS.Discovery, Alice.Registry

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    App -> Alice.UAS.Discovery 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    Alice.UAS.Discovery -> Alice.Registry 'Find Application Registration [Agent]' {
        notes'''
          since webid in credentials is the same as authorization agent owner
          it will search for application registration
        '''
    }
    Alice.Registry -> Alice.UAS.Discovery 'Application Registration'
    Alice.UAS.Discovery -> App 'OK with Link in a header to application registration'
  }

  dynamic view social-agent-registration-discovery {
    title: 'Discovery / Social Agent Registration'

    include Bob, Alice
    include Bob.UAS, Bob.UAS.Discovery, Alice.UAS, Alice.UAS.Discovery, Alice.Registry

    style Alice {
      color: green
    }

    style Bob {
      color: indigo
    }

    Bob.UAS.Discovery -> Alice.UAS.Discovery 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    Alice.UAS.Discovery -> Alice.Registry 'Find Social Agent Registration [Agent]' {
        notes'''
          since webid in credentials is different than authorization agent owner
          it will search for application registration
        '''
    }
    Alice.Registry -> Alice.UAS.Discovery 'Social Agent Registration'
    Alice.UAS.Discovery -> Bob.UAS.Discovery 'OK with Link in a header to social agent registration'
  }

  dynamic view org-registry-set-discovery {
    title: 'Discovery / Registry Set'

    include Dan, YoYo
    include Dan.UAS, Dan.UAS.Discovery, YoYo.UAS, YoYo.UAS.Discovery, YoYo.Registry

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    Dan.UAS.Discovery -> YoYo.UAS.Discovery 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    YoYo.UAS.Discovery -> YoYo.Registry 'find Social Agent Registration [Agent]' {
        notes'''
          admin marker — hasAdminGrant on the org's registration of the caller
          ---

          ```http
          HTTP/1.1 200 OK
          ```

          ```json
          {
            "id": "https://registry/yoyo/social-agent/z3k7wm/",
            "type": ["SocialAgentRegistration"],
            "registeredAgent": "https://id/dan",
            "hasAdminGrant": ["https://registry/yoyo/grant/a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d"]
          }
          ```
        '''
    }
    alt {
      if 'non-admin — no admin marker' {
        // early return — the request terminates here; illustrates the same
        // request when Dan is NOT an admin of YoYo
        YoYo.UAS.Discovery -> Dan.UAS.Discovery '200 OK without hasRegistrySet link'
      }
      else 'admin — hasAdminGrant' {
        YoYo.UAS.Discovery -> Dan.UAS.Discovery 'OK with Link in a header to registry set' {
            notes'''
              rel=interop:hasRegistrySet — admin only, evaluated against request credentials
            '''
        }
        Dan.UAS.Discovery -> YoYo.Registry 'resolve RegistrySet' {
            notes'''
              load registry set — agent registry, role registry, grant registry, data registries
            '''
        }
        Dan.UAS.Discovery -> YoYo.Registry 'read org registries - role registry [Role]' {
            notes'''
              admin session reads with own credentials
              ---

              ```http
              HTTP/1.1 200 OK
              ```
            '''
        }
      }
    }
  }

  dynamic view org-admin-add {
    title: 'Admin / Dan promotes Bob in YoYo'

    include Bob, YoYo, Dan
    include Bob.AUI, Bob.UAS, Bob.UAS.UiApi, Bob.UAS.Temporal, Bob.UAS.WebhookReceiver, Bob.UAS.Discovery, Bob.Registry, YoYo.UAS, YoYo.UAS.Temporal, YoYo.UAS.WebhookReceiver, YoYo.UAS.Discovery, YoYo.Registry, Dan.UAS, Dan.UAS.Discovery, Dan.UAS.WebhookReceiver, Dan.UAS.UiApi, Dan.AUI

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    style Bob {
      color: sky
    }

    Dan.AUI -> Dan.UAS.UiApi 'Connect to the notifications stream' {
        notes'''
          #### Connect to the notifications stream
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > response stays alive for streaming

          ```http
          GET https://auth/.sai/events
          Accept: application/x-ndjson
          ```
        '''
    }
    Dan.AUI -> Dan.UAS.UiApi 'POST (RPC) AddAdmin — { webId: bob, context: yoyo }' {
        navigateTo org-registry-set-discovery
        notes'''
          #### POST (RPC) AddAdmin - { webId: bob, context: yoyo }
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > resolves the org context — admin gate (hasAdminGrant) → registry
          > set — then operates on the org's registries as the authorized admin

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=4f8fe6e4-4a5a-4318-93f6-d8645778fc28
          ```

          ```json
          [
            {
              "request": {
                "_tag": "AddAdmin",
                "webId": "https://id/bob",
                "context": "https://id/yoyo"
              }
            }
          ]
          ```
        '''
    }
    Dan.UAS.Discovery -> YoYo.UAS.Discovery 'discover org registry set' {
        navigateTo org-registry-set-discovery
        notes'''
          #### discover org registry set
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          [org-registry-set-discovery](../org-registry-set-discovery/?dynamic=sequence)

          >[!TIP]
          > the admin-only `Link: <registrySet>; rel="interop:hasRegistrySet"`
          > header on the org's authorization agent (AgentIdHandler) — the
          > admin gate (hasAdminGrant) decides whether it is served

          ```http
          HEAD https://auth/.sai/agents/aHR0cHM6Ly9pZC95b3lv
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```http
          HTTP/1.1 200 OK
          Link: <https://registry/yoyo/>;
                rel="http://www.w3.org/ns/solid/interop#hasRegistrySet"
          ```
        '''
    }
    Dan.UAS.UiApi -> YoYo.Registry 'find Social Agent Registration [Agent]' {
        notes'''
          #### find Social Agent Registration [Agent]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > guard read — the promoted agent must already be registered
        '''
    }
    Dan.UAS.UiApi -> YoYo.Registry 'pre-mint AdminAuthorization id (validation reads)' {
        notes'''
          #### pre-mint AdminAuthorization id (validation reads)
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > step 5 (R1 re-decision): the registered + already-admin checks
          > stay RPC-side (error on duplicate); the resource id is PRE-MINTED
          > via `iriForContained` — no synchronous record, the workflow PUTs
          > the AdminAuthorization there later
        '''
    }
    Dan.UAS.UiApi -> YoYo.Registry 'PUT AdminAuthorizationGranted activity [Activity]' {
        notes'''
          #### PUT AdminAuthorizationGranted activity [Activity]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `yoyo`

          >[!TIP]
          > no synchronous record — `as:object` = the AA-to-be at the
          > PRE-MINTED id (real-id embedded projection: grantee, grantedBy,
          > scopeOfAuthorization); `target` dropped — the id rides object.id

          ```http
          PUT https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
            "type": ["Activity", "AdminAuthorizationGranted"],
            "as:actor": "https://id/yoyo",
            "as:object": {
              "id": "https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
              "type": ["AdminAuthorization"],
              "grantee": "https://id/bob",
              "grantedBy": "https://id/yoyo",
              "scopeOfAuthorization": "interop:All"
            },
            "interop:createdAt": "2024-01-01T10:00:00.000Z"
          }
          ```
          ---

          ```http
          HTTP/1.1 201 Created
          ```
        '''
    }
    parallel {
      Dan.UAS.UiApi -> Dan.AUI 'OK (pending) — pre-minted AA id + activityId' {
          notes'''
            #### OK (pending) - pre-minted AA id + activityId
            >[!NOTE]
            >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

            ```http
            HTTP/1.1 200 OK
            ```

            ```json
            {
              "_tag": "Success",
              "value": {
                "id": "https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
                "activityId": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c"
              }
            }
            ```
            ### Checks

            #### String matching
            * `id` - `https://registry/yoyo/authorization`
            * `activityId` - `https://registry/yoyo/activity`
            * no AdminAuthorization resource yet — the workflow PUTs it
          '''
      }
      YoYo.Registry -> YoYo.UAS.WebhookReceiver 'notify Add activity (owner channel — dispatch) [Activity]' {
          notes'''
            #### notify Add activity (owner channel - dispatch) [Activity]
            >[!NOTE]
            >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

            ```json
            {
              "@context": [
                "https://www.w3.org/ns/activitystreams",
                "https://www.w3.org/ns/solid/notifications-context/v1"
              ],
              "id": "urn:uuid:5f3d8b21-9c4e-4a7d-b2e6-1a0c8f3d7e9b",
              "type": "Add",
              "object": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
              "target": "https://registry/yoyo/activity/",
              "published": "2026-09-01T01:50:31.328Z"
            }
            ```
          '''
      }
    }
    YoYo.UAS.WebhookReceiver -> YoYo.UAS.Temporal 'start processAdminAuthorizationGranted workflow' {
        notes'''
          #### start processAdminAuthorizationGranted workflow
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          >gRPC

          >[!TIP]
          > the decoded object passes verbatim (the workflow's data arg); the
          > triggering activity rides as a typed ref — traceable completion

          ```json
          [
            "https://id/yoyo",
            {
              "id": "https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
              "type": ["AdminAuthorization"],
              "grantee": "https://id/bob",
              "grantedBy": "https://id/yoyo",
              "scopeOfAuthorization": "interop:All"
            },
            {
              "id": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
              "type": ["Activity", "AdminAuthorizationGranted"]
            }
          ]
          ```
          ---

          ```http
          HTTP/1.1 200 OK
          ```
        '''
    }
    YoYo.UAS.Temporal -> YoYo.UAS.Temporal '(workflow) run processAdminAuthorizationGranted' {
        notes'''
          #### (workflow) run processAdminAuthorizationGranted
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream
        '''
    }
    YoYo.UAS.Temporal -> YoYo.Registry '(activity) PUT AdminAuthorization [Authorization]' {
        notes'''
          #### (activity) PUT AdminAuthorization [Authorization]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `yoyo`

          >[!TIP]
          > `recordAdminAuthorizationAtId`: at the PRE-MINTED id — find-first
          > idempotent (a retry sees the resource already materialized and
          > skips; the `If-None-Match: *` PUT would 412 on the second attempt)

          ```http
          PUT https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
            "type": ["AdminAuthorization"],
            "grantee": "https://id/bob",
            "grantedBy": "https://id/yoyo",
            "scopeOfAuthorization": "interop:All"
          }
          ```
          ---

          ```http
          HTTP/1.1 201 Created
          ```
        '''
    }
    YoYo.UAS.Temporal -> YoYo.Registry '(child workflow) createAdminGrants [Grant]' {
        notes'''
          #### (child workflow) createAdminGrants [Grant]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > store RegistrySet-scoped + per data registry AdminGrants, each
          > with its own ACR
        '''
    }
    YoYo.UAS.Temporal -> YoYo.Registry '(activity) replace hasAdminGrant link [Agent]' {
        notes'''
          #### (activity) replace hasAdminGrant link [Agent]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `yoyo`

          >[!TIP]
          > single PATCH — one Update on the org's registration of the admin
          > (the admin marker; data registries are reached through the RegistrySet)

          ```http
          PATCH https://registry/yoyo/social-agent/z3k7wm/
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/yoyo/social-agent/z3k7wm/",
            "type": ["SocialAgentRegistration"],
            "interop:hasAdminGrant": [
              "https://registry/yoyo/grant/a1b2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
            ]
          }
          ```
          ---

          ```http
          HTTP/1.1 204 No Content
          ```
        '''
    }
    YoYo.Registry -> Bob.UAS.WebhookReceiver 'notify Update — hasAdminGrant PATCH on the reciprocal [Agent]' {
        notes'''
          #### notify Update — hasAdminGrant PATCH on the reciprocal [Agent]
          >[!NOTE]
          >admin-events.test.ts > the promoted agent learns via the reciprocal channel (delegatedGrantsUpdated)
          >[!TIP]
          > Bob holds a reciprocal webhook on YoYo's registration of him — the hasAdminGrant PATCH `Update` on `registry/yoyo/social-agent/<bob>/` is how he learns about the promotion (no channel on YoYo's ACTIVITY registry)
        '''
    }
    Bob.UAS.WebhookReceiver -> Bob.Registry 'PUT delegatedGrantsUpdated activity [Activity]' {
        notes'''
          #### PUT delegatedGrantsUpdated activity [Activity]
          >[!NOTE]
          >admin-events.test.ts > the promoted agent learns via the reciprocal channel (delegatedGrantsUpdated)
          >[!IMPORTANT]
          > Auth: Capability URL
          >[!TIP]
          > outbox only — the mirror maintenance runs as the `updateDelegatedGrants` workflow (started by ActivityWebhookHandler); `actor` = bob, as:target = yoyo (the peer whose reciprocal registration changed)
        '''
    }
    Bob.UAS.WebhookReceiver -> YoYo.Registry 'OK'
    YoYo.UAS.Temporal -> YoYo.Registry '(child workflow) syncAdminAcr — rewrite .acr #fullAdminAccess' {
        notes'''
          #### (child workflow) syncAdminAcr - rewrite .acr #fullAdminAccess
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > ACP resource — not a sub registry; derived rewrite from the
          > current admin list (the AuthorizationRegistry is the source of
          > truth; last-admin guard inside the activity)
        '''
    }
    YoYo.UAS.Temporal -> YoYo.Registry '(activity) create activityCompleted [Activity]' {
        notes'''
          #### (activity) create activityCompleted [Activity]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > only after grants AND ACR rewrite succeeded — single completion
          > (children never mark done — the createAdminGrants-masks-syncAdminAcr
          > hazard)

          ```http
          PUT https://registry/yoyo/activity/c6f2a0b9-4d5e-4a7f-9b3c-8e1d0f2a5c6d
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/yoyo/activity/c6f2a0b9-4d5e-4a7f-9b3c-8e1d0f2a5c6d",
            "type": ["Activity", "ActivityCompleted"],
            "as:target": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
            "interop:createdAt": "2024-01-01T10:00:02.000Z"
          }
          ```
          ---

          ```http
          HTTP/1.1 201 Created
          ```
        '''
    }
    YoYo.Registry -> Dan.UAS.WebhookReceiver 'notify Add activity (admin channel — forward only) [Activity]' {
        notes'''
          #### notify Add activity (admin channel - forward only) [Activity]
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > the change activity → pending, the completion → done (enriched
          > with the typed activity — the UI reads the embedded object)
        '''
    }
    Dan.UAS.WebhookReceiver -> Dan.AUI 'stream activity events (pending → done)' {
        notes'''
          #### stream activity events (pending - done)
          >[!NOTE]
          >admin-events.test.ts > the admin receives org-context admin activities (pending + done) on their stream

          >[!TIP]
          > /.sai/events NDJSON stream - formatted here for readability

          ```json
          {
            "type": "activity",
            "activity": {
              "id": "https://registry/yoyo/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
              "type": ["Activity", "AdminAuthorizationGranted"],
              "actor": "https://id/yoyo",
              "object": {
                "id": "https://registry/yoyo/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
                "type": ["AdminAuthorization"],
                "grantee": "https://id/bob",
                "grantedBy": "https://id/yoyo",
                "scopeOfAuthorization": "interop:All"
              },
              "createdAt": "2026-09-01T01:50:31.328Z",
              "status": "done"
            }
          }
          ```
        '''
    }
    Dan.AUI -> Dan.UAS.UiApi 'POST (RPC) ListSocialAgents (context: yoyo) — refresh' {
