  dynamic view org-admin-remove {
    title: 'Admin / Dan demotes Bob in YoYo'

    include Bob, YoYo, Dan
    include Bob.AUI, Bob.UAS, Bob.UAS.UiApi, Bob.UAS.Temporal, Bob.UAS.WebhookReceiver, Bob.UAS.Discovery, Bob.Registry, YoYo.UAS, YoYo.UAS.Temporal, YoYo.UAS.WebhookReceiver, YoYo.UAS.Discovery, YoYo.Registry, Dan.UAS, Dan.UAS.Discovery, Dan.UAS.WebhookReceiver, Dan.UAS.UiApi, Dan.AUI

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    style Bob {
      color: sky
    }

    Dan.AUI -> Dan.UAS.UiApi 'Connect to the notifications stream' {
        notes'''
          #### Connect to the notifications stream
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > response stays alive for streaming

          ```http
          GET https://auth/.sai/events
          Accept: application/x-ndjson
          ```
        '''
    }
    Dan.AUI -> Dan.UAS.UiApi 'POST (RPC) RemoveAdmin — { webId: bob, context: yoyo }' {
        navigateTo org-registry-set-discovery
        notes'''
          #### POST (RPC) RemoveAdmin - { webId: bob, context: yoyo }
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > activity-first (step 6 — R1 re-decided in full): the RPC keeps the
          > validation reads and writes the activity only — the workflow
          > DELETEs the AdminAuthorization

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=4f8fe6e4-4a5a-4318-93f6-d8645778fc28
          ```

          ```json
          [
            {
              "request": {
                "_tag": "RemoveAdmin",
                "webId": "https://id/bob",
                "context": "https://id/yoyo"
              }
            }
          ]
          ```
