                "context": "https://id/alice"
              }
            }
          ]
          ```
        '''
    }
    Alice.UAS -> Alice.Registry 'find the AccessRequest [AccessRequest registry]' {
        notes'''
          #### find the AccessRequest [AccessRequest registry]
          >[!NOTE]
          >access-request.test.ts > approval phase

          >[!IMPORTANT]
