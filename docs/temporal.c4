          {
            "@context": ["dataModelContext — interop terms compact to BARE keys (no interop: prefix)"],
            "type": ["NeedBasedAccessRequest"],
            "grantee": "https://id/bob",
            "grantedBy": "https://id/bob",
            "dataOwner": "https://id/alice",
            "hasAccessNeedGroup": {
              "id": "urn:uuid:6a1f3c2e-4b5d-4e6f-9a0b-1c2d3e4f5a6b",
