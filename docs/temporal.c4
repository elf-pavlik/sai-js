  dynamic view admin-invitation-send {
    title: 'Invitation — Dan as YoYo admin to Kim'

    include Kim, YoYo, Dan
    include Kim.AUI, Kim.UAS, Kim.ActivityWebhookHandler, Kim.Temporal, Kim.Registry, Kim.Worker, YoYo.Worker, YoYo.Registry, YoYo.Temporal, YoYo.ActivityWebhookHandler, YoYo.UAS, Dan.AUI, Dan.ActivityWebhookHandler, Dan.UAS

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    style Kim {
      color: sky
    }

    Dan.AUI -> Dan.UAS 'Connect to the notifications stream' {
        notes'''
          #### Connect to the notifications stream
          >[!NOTE]
          >invitation.test.ts > admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          >[!TIP]
          > response stays alive for streaming

          ```http
          GET https://auth/.sai/events
          Accept: application/x-ndjson
          ```
        '''
    }
    Dan.AUI -> Dan.UAS 'POST (RPC) createInvitation' {
        notes'''
          #### POST (RPC) createInvitation
          >[!NOTE]
          >invitation.test.ts > admin

          >[!IMPORTANT]
          > Auth: CSS cookie session as `dan`

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=4f8fe6e4-4a5a-4318-93f6-d8645778fc28
          ```

          ```json
          [
            {
              "request": {
                "_tag": "CreateInvitation",
                "label": "Kim",
                "note": "Some note",
                "context": "https://id/yoyo"
              }
            }
          ]
          ```
        '''
    }
    Dan.UAS -> YoYo.UAS 'discover org registry set' {
        navigateTo org-registry-set-discovery
        notes'''
          #### discover org registry set
          >[!NOTE]
          >invitation.test.ts > admin

          [org-registry-set-discovery](../org-registry-set-discovery/?dynamic=sequence)

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `dan`

