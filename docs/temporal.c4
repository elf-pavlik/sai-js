    parallel {
      Alice.UAS.Temporal -> Alice.UAS.Temporal '(child workflows) start create grants for each affected agent' {
          notes'''
            #### (child workflows) start create grants for each affected agent
            >[!NOTE]
            >roles.test.ts > update role chums remove kim add bob

            >[!TIP]
            > affected = changed members (role used as grantee) + grantees of
            > dataOwner authorizations
          '''
      }
      Alice.UAS.Temporal -> Alice.UAS.Temporal 'run createGrantsForAgent'
      Alice.UAS.Temporal -> Alice.Registry '(activity) replace grants + registration [Grant]' {
          notes'''
            #### (activity) replace grants + registration [Grant]
            >[!NOTE]
            >roles.test.ts > update role chums remove kim add bob

            >[!IMPORTANT]
            > Auth: Solid OIDC access token as `alice`

            >[!TIP]
            > members removed → no authorizations → registration cleared
            > (the deny path); members added → authorizations → grants stored

            ```http
            PATCH https://registry/alice/social-agent/cp9g7p/
            Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
            ```

            ```json
            {
              "@context": ["in reality payload uses Expanded JSON-LD"],
              "id": "https://registry/alice/social-agent/cp9g7p/",
              "type": ["SocialAgentRegistration"],
              "interop:hasDataGrant": []
            }
            ```
            ---

            ```http
            HTTP/1.1 204 No Content
            ```
          '''
      }
      Alice.Registry -> Alice.UAS.Temporal 'OK'
    }
    Alice.UAS.Temporal -> Alice.Registry 'PUT activityCompleted [Activity]' {
