          >[!TIP]
          > the object is the EXISTING AdminAuthorization (real-id embedded
          > projection at its real id — the workflow DELETEs it)
        '''
    }
    parallel {
      Kim.UAS.UiApi -> Kim.AUI 'OK (pending) — revoked AA id + activityId' {
          notes'''
            #### OK (pending) - revoked AA id + activityId
            >[!NOTE]
            >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)
          '''
      }
      Kim.Registry -> Kim.UAS.WebhookReceiver 'notify Add activity (owner channel — dispatch) [Activity]' {
          notes'''
            #### notify Add activity (owner channel - dispatch) [Activity]
            >[!NOTE]
            >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)
          '''
      }
    }
    Kim.UAS.WebhookReceiver -> Kim.UAS.Temporal 'start processAdminAuthorizationRevoked workflow' {
        notes'''
          #### start processAdminAuthorizationRevoked workflow
          >[!NOTE]
          >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)

          >[!TIP]
          >gRPC
          ---

          ```http
          HTTP/1.1 200 OK
          ```
        '''
    }
    Kim.UAS.Temporal -> Kim.UAS.Temporal '(workflow) run processAdminAuthorizationRevoked' {
        notes'''
          #### (workflow) run processAdminAuthorizationRevoked
          >[!NOTE]
          >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)
        '''
    }
    Kim.UAS.Temporal -> Kim.Registry '(activity) DELETE AdminAuthorization [Authorization]' {
        notes'''
          #### (activity) DELETE AdminAuthorization [Authorization]
          >[!NOTE]
          >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `kim`

          >[!TIP]
          > `deleteAdminAuthorizationAtId`: at the EXISTING id — find-first
          > 404-tolerant (a retry after a crash skips)
        '''
    }
    Kim.UAS.Temporal -> Kim.Registry '(child workflow) revokeAdminGrants [Grant]' {
        notes'''
          #### (child workflow) revokeAdminGrants [Grant]
          >[!NOTE]
          >personal-admin.test.ts > RemoveAdmin demotes the only admin — the owner remains (no last-admin lockout)

          >[!TIP]
          > find + delete the AdminGrants (resources + ACRs) and unlink
          > `hasAdminGrant` — single PATCH on Kim's registration of Alice
        '''
    }
    Kim.Registry -> Alice.UAS.WebhookReceiver 'notify Update — hasAdminGrant PATCH on the reciprocal [Agent]' {
        notes'''
          #### notify Update - hasAdminGrant PATCH on the reciprocal [Agent]
          >[!NOTE]
          >personal-admin.test.ts > Alice's UI learns about the demotion via the reciprocal channel (delegatedGrantsUpdated)

          >[!TIP]
