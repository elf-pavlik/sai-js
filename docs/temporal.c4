            ```http
            PUT https://registry/alice/access-request/3d7a5c9e-1f2b-4c6d-8e9a-0b1c2d3e4f5a
            Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
            ```

            ```json
            {
              "@context": ["dataModelContext — interop terms compact to BARE keys (no interop: prefix)"],
              "id": "https://registry/alice/access-request/3d7a5c9e-1f2b-4c6d-8e9a-0b1c2d3e4f5a",
              "type": ["NeedBasedAccessRequest"],
              "grantee": "https://id/bob",
              "grantedBy": "https://id/bob",
              "dataOwner": "https://id/alice",
              "hasAccessNeedGroup": {
                "id": "urn:uuid:6a1f3c2e-4b5d-4e6f-9a0b-1c2d3e4f5a6b",
                "type": ["AccessNeedGroup"],
                "hasAccessNeed": [
                  {
                    "id": "urn:uuid:7b2a4d3f-5c6e-4f70-9a1b-2c3d4e5f6a7b",
                    "type": ["AccessNeed"],
                    "registeredShapeTree": "https://data/shapetrees/trees/Project",
                    "required": "http://www.w3.org/ns/solid/interop#AccessRequired",
                    "accessMode": ["acl:Read", "acl:Create", "acl:Update", "acl:Delete"],
                    "hasInheritingNeed": [
                      {
                        "id": "urn:uuid:8c3b5e40-6d7f-4f81-9a2b-3c4d5e6f7a8b",
                        "type": ["AccessNeed"],
                        "registeredShapeTree": "https://data/shapetrees/trees/Task",
                        "required": "http://www.w3.org/ns/solid/interop#AccessRequired",
                        "accessMode": ["acl:Read", "acl:Create", "acl:Update", "acl:Delete"]
                      }
                    ]
                  }
                ]
              }
            }
            ```
            ---

            ```http
            HTTP/1.1 201 Created
            ```
          '''
      }
      Alice.UAS.Temporal -> Alice.Registry '(activity) create activityCompleted [Activity]'
      }
    }

  }  dynamic view authz-data-need-based-request {
    title: 'Authorization data (need based access request)'

    include Alice, Bob, Common
    include Alice.AUI, Alice.UAS, Alice.UAS.UiApi, Alice.Registry, Alice.Data, Common.Shapetrees

    style Alice {
      color: green
    }

    style Bob {
      color: indigo
    }

    style Common {
      color: slate
    }

    Alice.AUI -> Alice.UAS.UiApi 'POST (RPC) getAuthorizationData' {
        notes'''
          #### POST (RPC) getAuthorizationData
          >[!NOTE]
          >authorization.test.ts > approval phase

          >[!IMPORTANT]
          > Auth: CSS cookie session as `alice`

          >[!TIP]
          > the access need group comes from the EMBEDDED group in the request (`accessRequestIri`, added to `GetAuthoriaztionData`) — NO client-id document / reciprocal-registration fetch; grantee = Bob (the request's grantee, `agentType` = SocialAgent)

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=8187358a-2072-4dce-9c76-24caffcc84a4
          ```

          ```json
          [
            {
              "request": {
                "_tag": "GetAuthoriaztionData",
                "agentId": "https://id/bob",
                "agentType": "SocialAgent",
                "lang": "en",
                "accessRequestIri": "https://registry/alice/access-request/3d7a5c9e-1f2b-4c6d-8e9a-0b1c2d3e4f5a",
                "context": "https://id/alice"
              }
            }
          ]
          ```
        '''
    }
    Alice.UAS.UiApi -> Alice.Registry 'find the AccessRequest [AccessRequest registry]' {
        notes'''
          #### find the AccessRequest [AccessRequest registry]
          >[!NOTE]
          >authorization.test.ts > approval phase

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `alice`

          >[!TIP]
          > SPARQL read of the immutable request — the group resolves from its embedded copy

          ```http
          GET https://registry/alice/access-request/3d7a5c9e-1f2b-4c6d-8e9a-0b1c2d3e4f5a
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```
          ---

          ```http
          HTTP/1.1 200 OK
          ```
        '''
    }
    Alice.UAS.UiApi -> Alice.Data 'find relevant data registrations [Data]' {
        notes'''
          #### find relevant data registrations [Data]
          >[!NOTE]
          >authorization.test.ts > approval phase
        '''
    }
    Alice.UAS.UiApi -> Common.Shapetrees 'GET shapetrees descriptions' {
        notes'''
          #### GET shapetrees descriptions
          >[!NOTE]
          >authorization.test.ts > approval phase

          ```http
          GET https://shapetrees.acme/shapetrees
          ```
        '''
    }
    Alice.UAS.UiApi -> Alice.AUI 'OK authorization data' {
        notes'''
          #### OK authorization data
          >[!NOTE]
          >authorization.test.ts > approval phase
        '''
    }
    Alice.AUI .overview Alice.UAS 'authorize' {
        navigateTo authorization
        notes'''
          #### authorize
          >[!NOTE]
          >authorization.test.ts > approval phase

          >[!TIP]
          > reuses the existing authorization screen (`AuthorizeApp.vue`) + `recordAuthorization` — the request stays immutable, the authorization references it

          [authorization](../authorization/?dynamic=sequence)
        '''
    }
  }
}
