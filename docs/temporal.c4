  dynamic view role-membership-change {
    title: 'Roles / Alice updates members of the Chums role'

    include Alice
    include Alice.AUI, Alice.UAS, Alice.UAS.UiApi, Alice.UAS.Temporal, Alice.UAS.WebhookReceiver, Alice.Registry

    style Alice {
      color: green
    }

    Alice.AUI -> Alice.UAS.UiApi 'Connect to the notifications stream' {
        notes'''
          #### Connect to the notifications stream
          >[!NOTE]
          >roles.test.ts > update role chums remove kim add bob

          >[!IMPORTANT]
          > Auth: CSS cookie session as `alice`

          >[!TIP]
          > response stays alive for streaming

          ```http
          GET https://auth/.sai/events
          Accept: application/x-ndjson
          ```
        '''
    }
    Alice.AUI -> Alice.UAS.UiApi 'POST (RPC) updateRole' {
        notes'''
          #### POST (RPC) updateRole
          >[!NOTE]
          >roles.test.ts > update role chums remove kim add bob

          >[!IMPORTANT]
          > Auth: CSS cookie session as `alice`

          >[!TIP]
          > activity-first (step 2): the RPC only writes the activity — the
          > role is PATCHed by the workflow; a read-side existence guard stays

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=8187358a-2072-4dce-9c76-24caffcc84a4
          ```

          ```json
          [
            {
              "request": {
                "_tag": "UpdateRole",
                "id": "https://registry/alice/role/xcoq3l",
                "label": "Chums",
                "members": ["https://id/bob"],
                "context": "https://id/alice"
              }
            }
          ]
          ```
        '''
    }
    Alice.UAS.UiApi -> Alice.Registry 'PUT roleMembershipChanged activity [Activity]' {
        notes'''
          #### PUT roleMembershipChanged activity [Activity]
          >[!NOTE]
          >roles.test.ts > update role chums remove kim add bob

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `alice`

          >[!TIP]
          > `target` dropped — the changed role's id rides `object.id` (the
          > role-to-be, real-id embedded projection); `as:Update`

          ```http
          PUT https://registry/alice/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```json
          {
            "@context": ["in reality payload uses Expanded JSON-LD"],
            "id": "https://registry/alice/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
            "type": ["Activity", "RoleMembershipChanged", "as:Update"],
            "as:actor": "https://id/alice",
            "as:object": {
              "id": "https://registry/alice/role/xcoq3l",
              "type": ["Role"],
              "label": "Chums",
              "members": ["https://id/bob"]
            },
            "interop:createdAt": "2024-01-01T10:00:00.000Z"
          }
          ```
          ---

          ```http
          HTTP/1.1 201 Created
          ```
        '''
    }
    parallel {
      Alice.Registry -> Alice.UAS.UiApi 'pending ack (role-to-be + activityId)' {
          notes'''
            #### pending ack (role-to-be + activityId)
            >[!NOTE]
            >roles.test.ts > update role chums remove kim add bob

            ```http
            HTTP/1.1 200 OK
            ```

            ```json
            {
              "_tag": "Success",
              "value": {
                "id": "https://registry/alice/role/xcoq3l",
                "label": "Chums",
                "members": ["https://id/bob"],
                "activityId": "https://registry/alice/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c"
              }
            }
            ```
            ### Checks

            #### Compare with request
            * `label`
            * `members`

            #### String matching
            * `id` - `https://registry/alice/role`
            * `activityId` - `https://registry/alice/activity`
            * no synchronous PATCH — the role is updated by the workflow
          '''
      }
      Alice.Registry -> Alice.UAS.WebhookReceiver 'notify Add activity (subscription webhook) [Activity]' {
          notes'''
            #### notify Add activity (subscription webhook) [Activity]
            >[!NOTE]
            >roles.test.ts > update role chums remove kim add bob

            ```json
            {
              "@context": [
                "https://www.w3.org/ns/activitystreams",
                "https://www.w3.org/ns/solid/notifications-context/v1"
              ],
              "id": "urn:uuid:5f3d8b21-9c4e-4a7d-b2e6-1a0c8f3d7e9b",
              "type": "Add",
              "object": "https://registry/alice/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
              "target": "https://registry/alice/activity/",
              "published": "2026-09-01T01:50:31.328Z"
            }
            ```
          '''
      }
    }
    Alice.UAS.WebhookReceiver -> Alice.UAS.Temporal 'start processRoleMembershipChange workflow' {
        notes'''
          #### start processRoleMembershipChange workflow
          >[!NOTE]
          >roles.test.ts > update role chums remove kim add bob

          >[!TIP]
          >gRPC

          >[!TIP]
          > the decoded object passes verbatim (the workflow's data arg); the
          > triggering activity rides as a typed ref — traceable completion

          ```json
          [
            "https://id/alice",
            {
              "id": "https://registry/alice/role/xcoq3l",
              "type": ["Role"],
              "label": "Chums",
              "members": ["https://id/bob"]
            },
            {
              "id": "https://registry/alice/activity/2e9c5aa1-7d3b-4f8b-a6c4-9d0e1f2a3b4c",
              "type": ["Activity", "RoleMembershipChanged", "as:Update"]
            }
