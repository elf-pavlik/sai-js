specification {
  element security
  relationship overview {
    tail normal
  }
  relationship httpnotify
}

model {
  security ACME {
    component DelegationIssuance 'DelegationIssuance' 'auth'{
    }
    component WebhookSender 'WebhookSender' 'auth' {
    }
  }
  security Others {
    component WebhookReceiver 'WebhookReceiver' 'auth' {
    }
  }
  security Common {
    component Shapetrees 'Shapetrees' 'dir' {
    }
  }
  security Alice {
    component WebhookReceiver 'ReciprocalWebhookHandler' 'auth' {
    }
    component ActivityWebhookHandler 'ActivityWebhookHandler' 'auth' {
    }
    component WebhookSender 'WebhookSender' 'reg' {
    }
    component StreamingHTTPSender 'StreamingHTTPSender' 'reg' {
    }
    component Temporal 'Temporal Server' {
    }
    component Worker 'Temporal Worker' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component UAS 'User Authorization Server' 'auth' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Bob {
    component WebhookSender 'WebhookSender' 'registry' {
    }
    component ActivityWebhookHandler 'ActivityWebhookHandler' 'auth' {
    }
    component Temporal 'Temporal Server' {
    }
    component Worker 'Temporal Worker' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component UAS 'User Authorization Server' 'auth' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Kim {
    component ActivityWebhookHandler 'ActivityWebhookHandler' 'auth' {
    }
    component Temporal 'Temporal Server' {
    }
    component Worker 'Temporal Worker' {
    }
    component Registry 'Registry' 'registry' {
    }
    component UAS 'User Authorization Server' 'auth' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security Dan {
    component ActivityWebhookHandler 'ActivityWebhookHandler' 'auth' {
    }
    component Temporal 'Temporal Server' {
    }
    component Worker 'Temporal Worker' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component UAS 'User Authorization Server' 'auth' {
    }
    component AUI 'Authorization UI' 'ui' {
    }
  }
  security YoYo {
    component ActivityWebhookHandler 'ActivityWebhookHandler' 'auth' {
    }
    component Temporal 'Temporal Server' {
    }
    component Worker 'Temporal Worker' {
    }
    component Registry 'Registry' 'registry' {
    }
    component Data 'Data Registry' 'data' {
    }
    component UAS 'User Authorization Server' 'auth' {
    }
  }
  security Peers {
    component UAS 'User Authorization Server' 'auth' {
    }
  }
  security App {
    component StreamingHTTPReceiver 'StreamingHTTPReceiver' 'app' {
    }
    component UI 'App UI' 'app' {
    }
    component CID 'Controlled Identifier' 'app' {
    }
  }
}

views {
  dynamic view reciprocalUpdate {
    title: 'Reciprocal registration update'

    include Alice, ACME
    include DelegationIssuance, ACME.WebhookSender, Alice.WebhookReceiver, Alice.ActivityWebhookHandler, Alice.Registry, Alice.Temporal, Alice.Worker

    style Alice {
      color: green
    }

    style ACME {
      color: indigo
    }

    ACME.WebhookSender -> Alice.WebhookReceiver 'notify'
    Alice.WebhookReceiver -> Alice.Registry 'PUT delegatedGrantsUpdated activity [Activity]'
    Alice.WebhookReceiver -> ACME.WebhookSender 'OK'
    Alice.Registry -> Alice.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Alice.ActivityWebhookHandler -> Alice.Temporal 'start updateDelegatedGrants workflow'
    Alice.Temporal -> Alice.ActivityWebhookHandler 'OK'
    Alice.Temporal -> Alice.Worker '(workflow) run updateDelegatedGrants'
    Alice.Worker -> Alice.Registry 'find affected authorizations [Authorization]'
    parallel {
      Alice.Worker -> Alice.Temporal '(child workflows) start update grants workflows'
      Alice.Temporal -> Alice.Worker 'run update grants workflow'
      Alice.Worker -> DelegationIssuance '(activity) register delegation with resource owner'
      DelegationIssuance -> Alice.Worker 'OK'
      Alice.Worker -> Alice.Registry '(activity) update registration [Agent]'
      Alice.Registry -> Alice.Worker 'OK'
    }
    Alice.Worker -> Alice.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view delegationAfterNotification {
    title: 'Delegation after notification'

    include Bob, Alice
    include Bob.Registry, Bob.WebhookSender, Alice.WebhookReceiver, Alice.ActivityWebhookHandler, Alice.Registry, Alice.Temporal, Alice.Worker

    style Alice {
      color: green
    }

    style Bob {
      color: indigo
    }

    Bob.WebhookSender -> Alice.WebhookReceiver 'notify'
    Alice.WebhookReceiver -> Alice.Registry 'PUT delegatedGrantsUpdated activity [Activity]'
    Alice.WebhookReceiver -> Bob.WebhookSender 'OK'
    Alice.Registry -> Alice.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Alice.ActivityWebhookHandler -> Alice.Temporal 'start updateDelegatedGrants workflow'
    Alice.Temporal -> Alice.ActivityWebhookHandler 'OK'
    Alice.Temporal -> Alice.Worker '(workflow) run updateDelegatedGrants'
    Alice.Worker -> Alice.Registry 'find affected authorizations [Authorization]'
    parallel {
      Alice.Worker -> Alice.Temporal '(child workflows) start update grants workflows'
      Alice.Temporal -> Alice.Worker '(workflow) run update grants workflow'
      Alice.Worker -> Alice.Registry '(activity) update registration [Agent]'
      Alice.Registry -> Alice.Worker 'OK'
    }
    Alice.Worker -> Alice.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view applicationRegistrationDiscovery {
    title: 'Application Registration discovery'

    include Alice, App
    include Alice.UAS, Alice.Registry

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    App -> Alice.UAS 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    Alice.UAS -> Alice.Registry 'Find Application Registration [Agent]' {
        notes'''
          since webid in credentials is the same as authorization agent owner
          it will search for application registration
        '''
    }
    Alice.Registry -> Alice.UAS 'Application Registration'
    Alice.UAS -> App 'OK with Link in a header to application registration'
  }

  dynamic view socialAgentRegistrationDiscovery {
    title: 'Social Agent Registration discovery'

    include Bob, Alice
    include Bob.UAS, Alice.UAS, Alice.Registry

    style Alice {
      color: green
    }

    style Bob {
      color: indigo
    }

    Bob.UAS -> Alice.UAS 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    Alice.UAS -> Alice.Registry 'Find Social Agent Registration [Agent]' {
        notes'''
          since webid in credentials is different than authorization agent owner
          it will search for application registration
        '''
    }
    Alice.Registry -> Alice.UAS 'Social Agent Registration'
    Alice.UAS -> Bob.UAS 'OK with Link in a header to social agent registration'
  }

  dynamic view org-registry-set-discovery {
    title: 'Org Registry Set discovery'

    include Dan, YoYo, Bob
    include Dan.UAS, YoYo.UAS, YoYo.Registry

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    style Bob {
      color: gray
    }

    Dan.UAS -> YoYo.UAS 'HEAD authorization agent id' {
        notes'''
          with credentials
        '''
    }
    YoYo.UAS -> YoYo.Registry 'find Social Agent Registration [Agent]' {
        notes'''
          admin marker — hasAdminGrant on the org's registration of the caller
        '''
    }
    YoYo.Registry -> YoYo.UAS 'Social Agent Registration'
    YoYo.UAS -> Dan.UAS 'OK with Link in a header to registry set' {
        notes'''
          rel=interop:hasRegistrySet — admin only, evaluated against request credentials
        '''
    }
    Dan.UAS -> YoYo.Registry 'resolve RegistrySet' {
        notes'''
          load registry set — agent registry, role registry, grant registry, data registries
        '''
    }
    Dan.UAS -> YoYo.Registry 'read org registries - role registry [Role]' {
        notes'''
          admin session reads with own credentials
        '''
    }
    YoYo.Registry -> Dan.UAS 'roles'
    Bob.UAS -> YoYo.UAS 'HEAD authorization agent id' {
        notes'''
          non-admin — no admin marker
        '''
    }
    YoYo.UAS -> Bob.UAS '200 OK without hasRegistrySet link'
  }

  dynamic view org-admin-add {
    title: 'Add org admin'

    include Dan, YoYo
    include Dan.AUI, Dan.UAS, Dan.ActivityWebhookHandler, YoYo.UAS, YoYo.Registry, YoYo.ActivityWebhookHandler, YoYo.Temporal, YoYo.Worker

    style YoYo {
      color: green
    }

    style Dan {
      color: indigo
    }

    Dan.AUI -> Dan.UAS 'POST (RPC) AddAdmin — { webId: bob, context: yoyo }' {
        navigateTo org-registry-set-discovery
        notes'''
          uses cookie session with User Authorization Server
          resolves the org context — admin gate (hasAdminGrant) → registry set — then operates on the org's registries as the authorized admin
        '''
    }
    Dan.UAS -> YoYo.UAS 'HEAD authorization agent id' {
        notes'''
          with credentials — learns the org's registry set location
        '''
    }
    YoYo.UAS -> Dan.UAS 'OK with Link - interop:hasRegistrySet'
    Dan.UAS -> YoYo.Registry 'find Social Agent Registration [Agent]'
    Dan.UAS -> YoYo.Registry 'record AdminAuthorization [Authorization]' {
        notes'''
          idempotent — errors when already exists
        '''
    }
    Dan.UAS -> YoYo.Registry 'PUT adminAuthorizationRecorded activity [Activity]'
    Dan.UAS -> Dan.AUI 'OK — admin flag in payload'
    YoYo.Registry -> YoYo.ActivityWebhookHandler 'notify Add activity (owner channel — dispatch) [Activity]'
    YoYo.ActivityWebhookHandler -> YoYo.Temporal 'start processAdminChange workflow'
    YoYo.Temporal -> YoYo.ActivityWebhookHandler 'OK'
    YoYo.Temporal -> YoYo.Worker '(workflow) run processAdminChange'
    YoYo.Worker -> YoYo.Registry '(child workflow) createAdminGrants [Grant]' {
        notes'''
          store RegistrySet-scoped + per data registry AdminGrants, each with ACR
        '''
    }
    YoYo.Worker -> YoYo.Registry '(activity) replace hasAdminGrant link [Agent]' {
        notes'''
          single PATCH — one Update on the org's registration of the admin
        '''
    }
    YoYo.Worker -> YoYo.Registry '(child workflow) syncAdminAcr — rewrite .acr #fullAdminAccess' {
        notes'''
          ACP resource — not a sub registry
        '''
    }
    YoYo.Worker -> YoYo.Registry '(activity) create activityCompleted [Activity]' {
        notes'''
          only after grants AND ACR rewrite succeeded — single completion
        '''
    }
    YoYo.Registry -> Dan.ActivityWebhookHandler 'notify Add activity (admin channel — forward only) [Activity]' {
        notes'''
          change activity → pending, completion → done (enriched with activityType + payload)
        '''
    }
    Dan.ActivityWebhookHandler -> Dan.AUI 'stream activity events (pending → done)' {
        notes'''
          /.sai/events NDJSON stream
        '''
    }
    Dan.AUI -> Dan.UAS 'POST (RPC) ListSocialAgents (context: yoyo) — refresh' {
        notes'''
          triggered by the done event — reload the org context agent list
        '''
    }
    Dan.UAS -> YoYo.Registry 'list social agents with admin flag [Agent]'
    YoYo.Registry -> Dan.UAS 'list'
    Dan.UAS -> Dan.AUI 'OK — agents with admin flag'
  }

  dynamic view authorization-data-app {
    title: 'Authorization data (app)'

    include Alice, App, Common
    include App.CID, App.UI, Alice.AUI, Alice.UAS, Alice.Registry, Alice.Data, Common.Shapetrees

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    style Common {
      color: slate
    }

    App.UI -> Alice.AUI 'redirect'
    Alice.AUI -> Alice.UAS 'POST (RPC) getAuthorizationData'
    Alice.UAS -> App.CID 'GET discover access needs'
    App.CID -> Alice.UAS '200 OK'
    Alice.UAS -> Alice.Data 'find relevant data registrations [Data]'
    Alice.Data -> Alice.UAS 'list'
    Alice.UAS -> Alice.Registry 'find relevant grants to relevant data registrations [Grant]'
    Alice.Registry -> Alice.UAS 'list'
    Alice.UAS -> App.CID 'GET access needs descriptions'
    App.CID -> Alice.UAS '200 OK'
    Alice.UAS -> Common.Shapetrees 'GET shapetrees descriptions'
    Common.Shapetrees -> Alice.UAS '200 OK'
    Alice.UAS -> Alice.AUI 'OK authorization data'
    Alice.AUI .overview Alice.UAS 'authorize' {
        navigateTo authorization
        notes'''
          after user is done with authorization screen
        '''
    }
    Alice.AUI -> App.UI 'redirect back'
  }

  dynamic view authorization {
    title: 'Authorization'

    include Bob, App
    include Bob.AUI, Bob.UAS, Bob.ActivityWebhookHandler, Bob.Registry, Bob.Temporal, Bob.Worker

    style Bob {
      color: indigo
    }

    style App {
      color: gray
    }

    App -> Bob.AUI 'redirect'
    Bob.AUI .overview Bob.UAS 'get authorization data' {
        navigateTo authorization-data-app
        notes'''
          needed to render the authorization screen
        '''
    }
    Bob.AUI -> Bob.UAS 'POST (RPC) authorization' {
        notes'''
          uses cookie session with User Authorization Server
        '''
    }
    Bob.UAS -> Bob.Registry 'create Access Authorization [Authorization]'
    Bob.UAS -> Bob.Registry '(ensure) application registration if does not exist [Agent]'
    Bob.UAS -> Bob.Registry 'PUT authorizationRecorded activity [Activity]'
    Bob.UAS -> Bob.AUI '202 Accepted'
    Bob.Registry -> Bob.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Bob.ActivityWebhookHandler -> Bob.Temporal 'start per-grantee consumer (processGranteeActivities)'
    Bob.Temporal -> Bob.ActivityWebhookHandler 'OK'
    Bob.Temporal -> Bob.Worker '(workflow) run processGranteeActivities'
    parallel {
      Bob.Worker -> Bob.Registry '(activity) create grants [Grant]' {
          notes'''
            durable execution should ensure consistency
          '''
      }
      Bob.Registry -> Bob.Worker 'OK'
    }
    Bob.Worker -> Bob.Registry '(activity) create activityCompleted [Activity]'
    Bob.ActivityWebhookHandler -> Bob.AUI 'done'
    Bob.AUI -> App 'redirect back'
    App .overview Bob.UAS 'discover application registration' {
        navigateTo applicationRegistrationDiscovery
    }
    App -> Bob.Registry 'GET Application Registration [Agent]'
    Bob.Registry -> App 'Application Registration'
  }

  dynamic view invitation-create {
    title: 'Create invitation'

    include Alice, App
    include Alice.AUI, Alice.UAS, Alice.Registry, Alice.Temporal, Alice.Worker

    style Alice {
      color: green
    }

    Alice.AUI -> Alice.UAS 'POST (RPC) createInvitation' {
        notes'''
          uses cookie session with User Authorization Server
        '''
    }
    Alice.UAS -> Alice.Registry 'create Social Agent Invitation [Agent]'
    Alice.Registry -> Alice.UAS '201 Created'
    Alice.UAS -> Alice.AUI 'OK' {
        notes'''
          SocialAgentInvitation in the payload
        '''
      }
  }

  dynamic view invitation-accept {
    title: 'Accept invitation'
    description: '''
      Test case: https://sai.js.org/
    '''

    include Bob, Kim
    include Bob.AUI, Bob.UAS, Bob.Registry, Kim.AUI, Kim.UAS, Kim.Registry, Kim.ActivityWebhookHandler, Kim.Temporal, Kim.Worker

    style Kim {
      color: sky
    }

    style Bob {
      color: indigo
    }

    Bob.AUI -> Bob.UAS 'POST (RPC) acceptInvitation' {
      notes'''
        uses cookie session with User Authorization Server

        capabilityUrl
      '''
    }
    Bob.UAS -> Kim.UAS 'POST capabilityUrl' {
      notes'''
        with credentials
      '''
    }
    Kim.UAS -> Kim.Registry 'find Social Agent Invitation [Agent]'
    Kim.Registry -> Kim.UAS 'Social Agent Invitation'
    Kim.UAS -> Kim.Registry 'create Social Agent Registration [Agent]' {
      notes'''
        to keep indepotent check if already exists
      '''
    }
    Kim.Registry -> Kim.UAS '201 Created'
    Kim.UAS -> Kim.Registry 'PUT agentRegistrationAdded activity [Activity]'
    Kim.UAS -> Kim.Registry 'update Social Agent Invitation [Agent]'
    Kim.Registry -> Kim.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Kim.ActivityWebhookHandler -> Kim.Temporal 'start establishReciprocal workflow'
    Kim.Registry -> Kim.UAS 'OK'
    Kim.UAS -> Bob.UAS 'WebId'
    Bob.UAS -> Bob.Registry 'create Social Agent Registration [Agent]' {
      notes'''
        to keep indepotent check if already exists
      '''
    }
    Bob.Registry -> Bob.UAS '201 Created'
    Bob.UAS -> Bob.Registry 'discover and update reciprocal registration [Agent]'
    Bob.UAS -> Bob.AUI 'OK' {
      notes'''
        Social Agent in the payload
      '''
    }
    Kim.Temporal -> Kim.Worker '(workflow) run establishReciprocal'
    Kim.Worker -> Kim.Registry '(activity) discover and update reciprocal registration [Agent]' {
      notes'''
        depends on Bob's UAS already creating on, can fail if not done already and will retry
      '''
    }
    Kim.Worker -> Bob.Registry '(activity) subscribe webhook to reciprocal registration [Agent]'
    Kim.Worker -> Kim.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view role-membership-change {
    title: 'Role membership change'

    include Alice, App
    include Alice.AUI, Alice.UAS, Alice.Registry, Alice.ActivityWebhookHandler, Alice.Temporal, Alice.Worker

    style Alice {
      color: green
    }

    Alice.AUI -> Alice.UAS 'POST (RPC) updateRole' {
        notes'''
          uses cookie session with User Authorization Server
          role id, label and full members list
        '''
    }
    Alice.UAS -> Alice.Registry 'update role, diff members [Role]' {
        notes'''
          affected members = before.symmetricDifference(after)
        '''
    }
    Alice.Registry -> Alice.UAS 'Role'
    Alice.UAS -> Alice.Registry 'PUT roleMembershipChanged activity [Activity]' {
        notes'''
          only when members changed — peers = affected members
        '''
    }
    Alice.UAS -> Alice.AUI 'OK'
    Alice.Registry -> Alice.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Alice.ActivityWebhookHandler -> Alice.Temporal 'start processRoleMembershipChange workflow'
    Alice.Temporal -> Alice.ActivityWebhookHandler 'OK'
    Alice.Temporal -> Alice.Worker '(workflow) run processRoleMembershipChange'
    Alice.Worker -> Alice.Registry 'find role usage [Authorization]' {
        notes'''
          usedAsGrantee + dataOwner authorizations of the role
        '''
    }
    parallel {
      Alice.Worker -> Alice.Temporal '(child workflows) start create grants for each affected agent' {
          notes'''
            affected = peers (role used as grantee) + grantees of dataOwner authorizations
          '''
      }
      Alice.Temporal -> Alice.Worker 'run createGrantsForAgent'
      Alice.Worker -> Alice.Registry '(activity) create grants [Grant]' {
          notes'''
            members removed → no authorizations → registration cleared
          '''
      }
      Alice.Registry -> Alice.Worker 'OK'
      Alice.Worker -> Alice.Registry '(activity) update registration [Agent]' {
          notes'''
            Update notification — grant present/absent
          '''
      }
      Alice.Registry -> Alice.Worker 'OK'
    }
    Alice.Worker -> Alice.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view share-resource-get-data {
    title: 'Share resource - get data'

    include Alice, App
    include App.UI, Alice.AUI, Alice.UAS, Alice.Registry, Alice.Data

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    App.UI -> Alice.AUI 'redirect' {
      notes'''
        indicate `resource`
      '''
    }
    Alice.AUI -> Alice.UAS 'POST (RPC) getResource' {
        notes'''
          uses cookie session
        '''
    }
    Alice.UAS -> Alice.Data 'GET indicated resource [Data]'
    Alice.Data -> Alice.UAS '200 OK'
    Alice.UAS -> Alice.Registry 'find social agents with access [Authorization][Agent]'
    Alice.Registry -> Alice.UAS '200 OK - list'
    Alice.UAS -> Alice.AUI 'OK relevant data'
    Alice.AUI -> Alice.UAS 'share resource' {
      navigateTo share-resource
    }
  }

  dynamic view share-resource {
    title: 'Share resource'

    include Alice, App, Peers
    include App.UI, Alice.AUI, Alice.UAS, Alice.Registry, Alice.ActivityWebhookHandler, Alice.Temporal, Alice.Worker, Peers.UAS

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    style Peers.UAS {
      multiple: true
    }

    App.UI -> Alice.AUI 'redirect' {
      notes'''
        indicate `resource`
      '''
    }
    Alice.AUI -> Alice.UAS 'get resource data' {
      navigateTo share-resource-get-data
    }
    Alice.AUI -> Alice.UAS 'POST (RPC) shareResource' {
        notes'''
          uses cookie session
          includes list of agents and access modes
        '''
    }
    Alice.UAS -> Alice.Registry 'share data instance creates data authorizations [Authorization]' {
        notes'''
          synchronous
        '''
    }
    Alice.Registry -> Alice.UAS 'data authorizations'
    Alice.UAS -> Alice.Registry 'PUT authorizationRecorded activity [Activity]' {
        notes'''
          one per grantee
        '''
    }
    Alice.Registry -> Alice.ActivityWebhookHandler 'notify Add activity (subscription webhook) [Activity]'
    Alice.ActivityWebhookHandler -> Alice.Temporal 'start per-grantee consumer (processGranteeActivities)'
    Alice.UAS -> Alice.AUI 'OK confirmation' {
        notes'''
          callbackEndpoint in the payload
        '''
    }
    Alice.AUI -> App.UI 'redirect back'
    Alice.Temporal -> Alice.Worker '(workflow) run processGranteeActivities'
    parallel {
      Alice.Worker -> Alice.Registry '(activity) create grants [Grant]' {
        notes'''
          durable execution should ensure consistency
        '''
      }
      Alice.Registry -> Alice.Worker 'OK'
      Alice.Worker -> Peers.UAS '(activity) request delegated grants (AccessRequest)'
      Peers.UAS -> Alice.Worker 'grant IRIs'
    }
    Alice.Worker -> Alice.Registry '(activity) create activityCompleted [Activity]'
  }

  dynamic view request-access {
    title: 'Request access'

    include Bob, Alice, App
    include App.CID, Bob.AUI, Bob.UAS, Bob.Registry, Alice.UAS

    style Alice {
      color: green
    }

    style Bob {
      color: indigo
    }

    style App {
      color: gray
    }

    Bob.AUI -> Bob.UAS 'POST (RPC) requestAccessUsingApplicationNeeds' {
      notes'''
        uses cookie session
      '''
    }
    Bob.UAS -> Bob.Registry 'find social agent registration [Agent]'
    Bob.Registry -> Bob.UAS '200 OK'
    Bob.UAS -> App.CID 'GET identity document' {
      notes'''
        To find access need group
      '''
    }
    App.CID -> Bob.UAS '200 OK'
    Bob.UAS -> Bob.Registry 'add access need group to social agent registration [Agent]'
    Bob.Registry -> Bob.UAS '200 OK'
    Bob.UAS -> Bob.AUI 'OK confirmation'
    Alice.UAS .overview Bob.UAS 'authorize' {
        navigateTo authorization
        notes'''
          same flow as authorizing application, minus redirects
        '''
    }
  }
}
