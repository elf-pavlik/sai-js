views "Authorization" {
  dynamic view authorization-data-app {
    title: 'Authorization data (app)'

    include Alice, App, Common
    include App.CID, App.UI, Alice.AUI, Alice.UAS, Alice.UAS.UiApi, Alice.Registry, Alice.Data, Common.Shapetrees

    style Alice {
      color: green
    }

    style App {
      color: gray
    }

    style Common {
      color: slate
    }

    App.UI -> Alice.AUI 'redirect'
    Alice.AUI -> Alice.UAS.UiApi 'POST (RPC) getAuthorizationData'
    Alice.UAS.UiApi -> App.CID 'GET discover access needs'
    App.CID -> Alice.UAS.UiApi '200 OK'
    Alice.UAS.UiApi -> Alice.Data 'find relevant data registrations [Data]'
    Alice.Data -> Alice.UAS.UiApi 'list'
    Alice.UAS.UiApi -> Alice.Registry 'find relevant grants to relevant data registrations [Grant]'
    Alice.Registry -> Alice.UAS.UiApi 'list'
    Alice.UAS.UiApi -> App.CID 'GET access needs descriptions'
    App.CID -> Alice.UAS.UiApi '200 OK'
    Alice.UAS.UiApi -> Common.Shapetrees 'GET shapetrees descriptions'
    Common.Shapetrees -> Alice.UAS.UiApi '200 OK'
    Alice.UAS.UiApi -> Alice.AUI 'OK authorization data'
    Alice.AUI .overview Alice.UAS 'authorize' {
        navigateTo authorization
        notes'''
          after user is done with authorization screen
        '''
    }
    Alice.AUI -> App.UI 'redirect back'
  }

  dynamic view authorization {
    title: 'Authorization'

    include Bob, App
    include Bob.AUI, Bob.UAS, Bob.UAS.UiApi, Bob.UAS.Temporal, Bob.UAS.WebhookReceiver, Bob.Registry

    style Bob {
      color: indigo
    }

    style App {
      color: gray
    }

    App -> Bob.AUI 'redirect'
    Bob.AUI .overview Bob.UAS 'get authorization data' {
        navigateTo authorization-data-app
        notes'''
          needed to render the authorization screen
        '''
    }
    Bob.AUI -> Bob.UAS.UiApi 'POST (RPC) authorization' {
        notes'''
          #### POST (RPC) authorization
          >[!NOTE]
          >authorization.test.ts > the grant leg (AuthorizeApp)

          >[!IMPORTANT]
          > Auth: CSS cookie session as `bob`

          >[!TIP]
          > the RPC is a VALIDATION + WRITE-ONLY endpoint: the
          > DataAuthorizations-to-be are PRE-MINTED by the AA rules and ride
          > the activity as embedded POJOs (the enum structure's term-gap) —
          > NO synchronous mutation (activity-first, authorization-granting.md
          > Step 2/§5.1)

          ```http
          POST https://auth/.sai/api
          Cookie: css-account=339642f3-f3ee-42e5-85b9-4b1ab6b27ddc
          ```

          ```json
          [
            {
              "request": {
                "_tag": "AuthorizeApp",
                "authorization": {
                  "grantee": "https://data/test-client/public/id",
                  "agentType": "http://www.w3.org/ns/solid/interop#Application",
                  "accessNeedGroup": "https://data/test-client/public/access-needs#need-group-pm",
                  "dataAuthorizations": [
                    {
                      "accessNeed": "https://data/test-client/public/access-needs#need-project",
                      "scope": "AllFromAgent",
                      "dataOwner": "https://id/bob"
                    },
                    { "accessNeed": "https://data/test-client/public/access-needs#need-task", "scope": "Inherited" },
                    { "accessNeed": "https://data/test-client/public/access-needs#need-image", "scope": "Inherited" },
                    { "accessNeed": "https://data/test-client/public/access-needs#need-file", "scope": "Inherited" }
                  ],
                  "granted": true
                },
                "context": "https://id/bob"
              }
            }
          ]
          ```
        '''
    }
    Bob.UAS.UiApi -> Bob.Registry 'PUT AuthorizationGranted activity (embedded DAs at pre-minted ids) [Activity]' {
        notes'''
          #### PUT AuthorizationGranted activity (embedded DAs at pre-minted ids)
          >[!NOTE]
          >authorization.test.ts > the activity-first granting (Step 2)

          >[!IMPORTANT]
          > Auth: Solid OIDC access token as `bob`

          >[!TIP]
          > ONE activity carries ALL grantees' DAs (the parent groups them —
          > grantee rides every POJO); the DAs are embedded at their
          > PRE-MINTED ids (find-first PUT by the child workflow); a decline
          > (granted:false) is a separate `AuthorizationDenied` activity
          > (Step 4 — forward-only, no delete)

          ```http
          PUT https://registry/bob/activity/9e8d7c6b-5a4f-4e3d-2c1b-0a9f8e7d6c5b
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          Content-Type: application/ld+json
          If-None-Match: *
          ```

          ```json
          {
            "@context": "https://www.w3.org/ns/solid/interp/v1",
            "@id": "https://registry/bob/activity/9e8d7c6b-5a4f-4e3d-2c1b-0a9f8e7d6c5b",
            "@type": ["Activity", "AuthorizationGranted"],
            "actor": "https://id/bob",
            "target": "https://registry/bob/authorization/",
            "object": [
              {
                "@id": "https://registry/bob/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
                "@type": ["http://www.w3.org/ns/solid/interop#DataAuthorization"],
                "grantee": "https://data/test-client/public/id",
                "grantedBy": "https://id/bob",
                "registeredShapeTree": "https://data/shapetrees/trees/Project",
                "scopeOfAuthorization": "http://www.w3.org/ns/solid/interop#AllFromAgent",
                "dataOwner": "https://id/bob",
                "accessMode": ["http://www.w3.org/ns/auth/acl#Read"]
              }
            ],
            "createdAt": "2026-09-01T01:50:31.328Z"
          }
          ```
          ---

          ```http
          HTTP/1.1 201 Created
          ```
        '''
    }
    Bob.UAS.UiApi -> Bob.AUI '202 (pending) — ids + activityId' {
        notes'''
          #### 202 (pending) — ids + activityId
          >[!NOTE]
          >authorization.test.ts > the pending ack (AuthorizationGrantedMessage)

          >[!TIP]
          > the ack echoes the pre-minted DataAuthorization ids (pending
          > handles) + the triggering activity id (the uniform UI claim
          > anchor — the done-row refresh arrives via `events.ts`)

          ```json
          {
            "id": "https://registry/bob/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c",
            "activityId": "https://registry/bob/activity/9e8d7c6b-5a4f-4e3d-2c1b-0a9f8e7d6c5b"
          }
          ```
        '''
    }
    Bob.Registry -> Bob.UAS.WebhookReceiver 'notify Add activity (subscription webhook) [Activity]'
    Bob.UAS.WebhookReceiver -> Bob.UAS.Temporal 'start processAuthorizationGranted workflow' {
        notes'''
          #### start processAuthorizationGranted workflow
          >[!NOTE]
          >authorization.test.ts > the activity-first granting (Step 2)

          >[!TIP]
          >gRPC

          ---

          ```http
          HTTP/1.1 200 OK
          ```
        '''
    }
    Bob.UAS.Temporal -> Bob.UAS.Temporal '(workflow) run processAuthorizationGranted' {
        notes'''
          #### (workflow) run processAuthorizationGranted
          >[!NOTE]
          >authorization.test.ts > the parent groups the embedded DAs by
          > grantee — ONE child per agent (always fan out, single grantee
          > included); children never mark done
        '''
    }
    parallel {
      loop 'grantees.each' {
        Bob.UAS.Temporal -> Bob.UAS.Temporal '(child workflows) start processGranteeAuthorization per grantee'
        Bob.UAS.Temporal -> Bob.UAS.Temporal '(workflow) run processGranteeAuthorization'
        Bob.UAS.Temporal -> Bob.Registry '(activity) PUT DataAuthorizations at the pre-minted ids [Authorization]' {
            notes'''
              #### (activity) PUT DataAuthorizations at the pre-minted ids
              >[!NOTE]
              >authorization.test.ts > the child body — find-first idempotent
              > (`If-None-Match: *`), session ensure-application-registration

              >[!IMPORTANT]
              > Auth: Solid OIDC access token as `bob`

              ```http
              PUT https://registry/bob/authorization/4f8a3b2c-1d9e-4c7a-8b6f-3e2d1c0a9b7c
              Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
              ```
              ---

              ```http
              HTTP/1.1 201 Created
              ```
            '''
        }
        parallel {
          loop 'grants.each' {
            Bob.UAS.Temporal -> Bob.Registry '(activity) create grants [Grant]' {
                notes'''
                  #### (activity) create grants [Grant]
                  >[!NOTE]
                  >authorization.test.ts > the registration update signals the outcome

                  >[!TIP]
                  > durable execution should ensure consistency
                '''
            }
          }
        }
      }
    }
    Bob.UAS.Temporal -> Bob.Registry '(activity) create activityCompleted [Activity]' {
        notes'''
          #### (activity) create activityCompleted [Activity]
          >[!NOTE]
          >authorization.test.ts > a SINGLE completion at the PARENT after
          > ALL children succeed (§5.1 — no per-grantee completions)
        '''
    }
    Bob.UAS.WebhookReceiver -> Bob.AUI 'done'
    Bob.AUI -> App 'redirect back'
    App .overview Bob.UAS 'discover application registration' {
        navigateTo application-registration-discovery
    }
    App -> Bob.Registry 'GET Application Registration [Agent]'
    Bob.Registry -> App 'Application Registration'
  }
}

views {
  dynamic view invitation {
    title: 'Invitation / Dan invites Kim'

    include Kim, Dan
    include Kim.AUI, Kim.UAS, Kim.UAS.UiApi, Kim.UAS.Temporal, Kim.UAS.WebhookReceiver, Kim.UAS.Discovery, Kim.Registry, Dan.Registry, Dan.UAS.Discovery, Dan.UAS.WebhookReceiver, Dan.UAS.Temporal, Dan.UAS.UiApi, Dan.UAS, Dan.AUI

    style Dan {
      color: sky
    }

    style Kim {
      color: indigo
    }

    Dan.AUI -> Dan.UAS.UiApi 'Connect to the notifications stream' {
        notes'''
