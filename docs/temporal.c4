    }
    Dan.UAS.Discovery -> YoYo.UAS.Discovery 'discover org registry set' {
        navigateTo org-registry-set-discovery
        notes'''
          #### discover org registry set
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          [org-registry-set-discovery](../org-registry-set-discovery/?dynamic=sequence)

          >[!TIP]
          > the admin-only `Link: <registrySet>; rel="interop:hasRegistrySet"`
          > header on the org's authorization agent (AgentIdHandler)

          ```http
          HEAD https://auth/.sai/agents/aHR0cHM6Ly9pZC95b3lv
          Authorization: DPoP eyJhbGciOiJFUzI1NiIs…
          ```

          ```http
          HTTP/1.1 200 OK
          Link: <https://registry/yoyo/>;
                rel="http://www.w3.org/ns/solid/interop#hasRegistrySet"
          ```
        '''
    }
    Dan.UAS.UiApi -> YoYo.Registry 'find Social Agent Registration [Agent]' {
        notes'''
          #### find Social Agent Registration [Agent]
          >[!NOTE]
          >admin-events.test.ts > demotion removes the admin from the ACR while keeping the remaining admin

          >[!TIP]
          > guard read — the demoted agent must be registered
