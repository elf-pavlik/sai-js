---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import ReadmeFromRepo from "../components/ReadmeFromRepo.astro";
import { PLAYLIST_VIDEOS } from "../data/playlist";

const assetBase = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme") || "auto";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var effectiveTheme = saved === "auto" ? (prefersDark ? "dark" : "light") : saved;
        document.documentElement.setAttribute("data-theme", saved);
        document.documentElement.classList.add(effectiveTheme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>SAI-JS — Architecture & media</title>
    <script src={`${assetBase}likec4-webcomponent.js`}></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Skip to content</a>
    <Navigation />

    <main id="content">
      <h1 class="visually-hidden">Solid Application Interoperability</h1>
      <section id="intro" class="section">
        <p>
          SAI-JS is a TypeScript implementation of the
          <a href="https://solidproject.org">Solid</a> Application Interoperability
          specification, providing modules for Solid applications and authorization
          agents.
        </p>
      </section>
      <section id="architecture" class="section" aria-labelledby="section-c4">
        <h2>Architecture</h2>
        <p>This is a <a href="https://likec4.dev">LikeC4</a> generated web component. You can interact with this diagram!</p>
        <div class="diagram-surface">
          <likec4-view view-id="index" />
        </div>
      </section>

      <section id="videos" class="section" aria-labelledby="section-videos">
        <h2>Videos</h2>
        <p>Watch demostrations of various features, and deployment instructions</p>
        <ul class="video-grid" role="list">
          {PLAYLIST_VIDEOS.map((v) => (
            <li class="video-item">
              <p class="video-title">{v.title}</p>
              <div class="video-embed">
                <iframe
                  title={v.title}
                  src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  loading="lazy"
                />
              </div>
            </li>
          ))}
        </ul>
      </section>
      <section id="localization" class="section" aria-labelledby="section-doc">
        <h2>Localization</h2>
        <ReadmeFromRepo section="Localization" showHeading={false} />
      </section>
      <section id="funding" class="section" aria-labelledby="section-funding">
        <h2>Funding</h2>
        <ReadmeFromRepo section="Funding" showHeading={false} />
      </section>
    </main>
  </body>
</html>
