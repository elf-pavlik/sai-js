{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/asynchronous-handlers/^1.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@elfpavlik/sai-components/^1.0.0/components/context.jsonld"
  ],
  "import": ["css:config/http/handler/handlers/storage-description.json"],
  "@graph": [
    {
      "comment": "These are all the handlers a request will go through until it is handled.",
      "@id": "urn:solid-server:default:HttpHandler",
      "@type": "SequenceHandler",
      "handlers": [
        { "@id": "urn:solid-server:default:Middleware" },
        {
          "@id": "urn:solid-server:default:BaseHttpHandler",
          "@type": "StatusWaterfallHandler",
          "handlers": [
            { "@id": "urn:sai:default:AuthorizationAgentHandler" },
            { "@id": "urn:solid-server:default:StaticAssetHandler" },
            { "@id": "urn:solid-server:default:OidcHandler" },
            { "@id": "urn:solid-server:default:NotificationHttpHandler" },
            { "@id": "urn:solid-server:default:StorageDescriptionHandler" },
            { "@id": "urn:solid-server:default:AuthResourceHttpHandler" },
            { "@id": "urn:solid-server:default:IdentityProviderHandler" },
            { "@id": "urn:solid-server:default:LdpHandler" }
          ]
        }
      ]
    },
    {
      "comment": "SAI",
      "@id": "urn:sai:default:AuthorizationAgentHandler",
      "@type": "RouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "targetExtractor": { "@id": "urn:solid-server:default:TargetExtractor" },
      "allowedPathNames": ["^/.sai/.*"],
      "handler": { "@id": "urn:sai:default:AuthorizationAgentParsingHandler" }
    },
    {
      "@id": "urn:sai:default:AuthorizationAgentParsingHandler",
      "@type": "ParsingHttpHandler",
      "requestParser": { "@id": "urn:solid-server:default:RequestParser" },
      "errorHandler": { "@id": "urn:solid-server:default:ErrorHandler" },
      "responseWriter": { "@id": "urn:solid-server:default:ResponseWriter" },
      "operationHandler": {
        "@id": "urn:sai:default:RestRouter",
        "@type": "StatusWaterfallHandler",
        "handlers": [
          { "@id": "urn:sai:default:AuthorizationAgentFrontendApi" },
          { "@id": "urn:sai:default:EventsRouter" },
          { "@id": "urn:sai:default:GrantIssuanceRouter" },
          { "@id": "urn:sai:default:ReciprocalWebhookRouter" },
          { "@id": "urn:sai:default:ActivityWebhookRouter" },
          { "@id": "urn:sai:default:AuthorizationAgentDiscoveryHandler" },
          { "@id": "urn:sai:default:AdminSparqlRouter" },
          { "@id": "urn:sai:default:ProxyAdminRouter" },
          { "@id": "urn:sai:default:InvitationRouter" }
        ]
      }
    },
    {
      "@id": "urn:sai:default:AuthorizationEndpointRoute",
      "@type": "AbsolutePathInteractionRoute",
      "path": { "@id": "urn:sai:default:variable:authorizationEndpoint" },
      "ensureSlash": false
    },
    {
      "comment": "Handles reading and writing notification subscriptions and channels.",
      "@id": "urn:sai:default:AuthorizationAgentDiscoveryHandler",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/agents/.*"],
      "allowedMethods": ["GET", "HEAD"],
      "handler": {
        "comment": "Converts outgoing responses based on the user preferences",
        "@type": "ConvertingOperationHttpHandler",
        "converter": { "@id": "urn:solid-server:default:RepresentationConverter" },
        "operationHandler": {
          "@id": "urn:sai:default:AgentIdHandler",
          "comment": "Responds with ClientID document and handles agent registration discovery.",
          "@type": "AgentIdHandler",
          "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
          "sessionManager": { "@id": "urn:sai:default:SessionManager" },
          "authorizationEndpoint": { "@id": "urn:sai:default:AuthorizationEndpointRoute" },
          "delegationEndpoint": { "@id": "urn:sai:default:DelegationEndpointRoute" }
        }
      }
    },
    {
      "comment": "Query-only SPARQL endpoint for org admins (QUERY method; POST is the DPoP-verifiable transport — the access-token verifier whitelists only standard methods).",
      "@id": "urn:sai:default:AdminSparqlRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/sparql-admin/.*"],
      "allowedMethods": ["QUERY", "POST"],
      "handler": {
        "@id": "urn:sai:default:AdminSparqlHandler",
        "comment": "Gate-kept SPARQL query endpoint: admin of the org (hasAdminGrant) may run SELECT/ASK/CONSTRUCT.",
        "@type": "AdminSparqlHandler",
        "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" },
        "sparqlEndpoint": { "@id": "urn:solid-server:default:variable:sparqlEndpoint" }
      }
    },
    {
      "comment": "Read-only peer-data proxy for org admins (GET).",
      "@id": "urn:sai:default:ProxyAdminRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/proxy-admin/.*"],
      "allowedMethods": ["GET"],
      "handler": {
        "@id": "urn:sai:default:ProxyAdminHandler",
        "comment": "Fetches a peer resource (data registration/instance) with the org's credentials and serves it to the admin's UI.",
        "@type": "ProxyAdminHandler",
        "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" }
      }
    },
    {
      "comment": "Handles invitation capability URLs.",
      "@id": "urn:sai:default:InvitationRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/invitations/.*"],
      "allowedMethods": ["POST"],
      "handler": {
        "@id": "urn:sai:default:InvitationHandler",
        "comment": "Handles request from another agent accepting an invitation.",
        "@type": "InvitationHandler",
        "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" }
      }
    },
    {
      "comment": "Endpoint that issuess delegated grants.",
      "@id": "urn:sai:default:DelegationEndpointRoute",
      "@type": "RelativePathInteractionRoute",
      "base": {
        "@type": "AbsolutePathInteractionRoute",
        "path": { "@id": "urn:solid-server:default:variable:baseUrl" }
      },
      "relativePath": "/.sai/grants",
      "ensureSlash": false
    },
    {
      "comment": "Handles issuance of grants.",
      "@id": "urn:sai:default:GrantIssuanceRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/grants"],
      "allowedMethods": ["POST"],
      "handler": {
        "@id": "urn:sai:default:GrantIssuanceHandler",
        "comment": "Handles request from another agent requesting grant delegation.",
        "@type": "GrantIssuanceHandler",
        "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" },
        "sparqlEndpoint": { "@id": "urn:solid-server:default:variable:sparqlEndpoint" }
      }
    },
    {
      "comment": "Handles webhook notifications from reciprocal registrations.",
      "@id": "urn:sai:default:ReciprocalWebhookRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/reciprocal-webhook/.*"],
      "allowedMethods": ["POST"],
      "handler": {
        "@id": "urn:sai:default:ReciprocalWebhookHandler",
        "comment": "Handles webhook notifications for reciprocal registrations.",
        "@type": "ReciprocalWebhookHandler",
        "credentialsExtractor": { "@id": "urn:solid-server:default:CredentialsExtractor" },
        "reciprocalWebhookStore": { "@id": "urn:sai:default:ReciprocalWebhookStore" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" }
      }
    },
    {
      "comment": "Handles webhook notifications from the Activity Registry.",
      "@id": "urn:sai:default:ActivityWebhookRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/activity-webhook/.*"],
      "allowedMethods": ["POST"],
      "handler": {
        "@id": "urn:sai:default:ActivityWebhookHandler",
        "comment": "Handles webhook notifications for activity resources.",
        "@type": "ActivityWebhookHandler",
        "activityWebhookStore": { "@id": "urn:sai:default:ActivityWebhookStore" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" },
        "activityEvents": { "@id": "urn:sai:default:ActivityEvents" }
      }
    },
    {
      "comment": "Always-open NDJSON event stream for the UI.",
      "@id": "urn:sai:default:EventsRouter",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/events$"],
      "allowedMethods": ["GET"],
      "handler": {
        "@id": "urn:sai:default:EventsHandler",
        "comment": "Streams activity events to the UI.",
        "@type": "EventsHandler",
        "cookieStore": { "@id": "urn:solid-server:default:CookieStore" },
        "webIdStore": { "@id": "urn:solid-server:default:WebIdStore" },
        "activityEvents": { "@id": "urn:sai:default:ActivityEvents" }
      }
    },
    {
      "comment": "Handles RPC API for the frontend.",
      "@id": "urn:sai:default:AuthorizationAgentFrontendApi",
      "@type": "OperationRouterHandler",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "allowedPathNames": ["^/.sai/api$"],
      "allowedMethods": ["POST"],
      "handler": {
        "@id": "urn:sai:default:FrontendRPCHandler",
        "comment": "Frontend RPC API",
        "@type": "ApiHandler",
        "cookieStore": { "@id": "urn:solid-server:default:CookieStore" },
        "webIdStore": { "@id": "urn:solid-server:default:WebIdStore" },
        "uiPushSubscriptionStore": { "@id": "urn:sai:default:UiPushSubscriptionStore" },
        "sessionManager": { "@id": "urn:sai:default:SessionManager" },
        "accountService": { "@id": "urn:sai:default:AccountService" },
        "sparqlEndpoint": { "@id": "urn:solid-server:default:variable:sparqlEndpoint" }
      }
    },
    {
      "@id": "urn:sai:default:SessionManager",
      "comment": "Manages SAI sessions.",
      "@type": "SessionManager",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "jwkGenerator": { "@id": "urn:solid-server:default:JwkGenerator" },
      "regOrigin": { "@id": "urn:sai:default:variable:regOrigin" },
      "sparqlEndpoint": { "@id": "urn:solid-server:default:variable:sparqlEndpoint" },
      "expiration": 60
    }
  ]
}
