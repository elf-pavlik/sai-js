{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@elfpavlik/sai-components/^1.0.0/components/context.jsonld"
  ],
  "import": [],
  "@graph": [
    {
      "comment": "Flat LWS storage: every new resource is allocated directly under the pod root with a UUID (a UUID Slug is honored), and containment is stored as lws:contains/lws:partOf metadata instead of being derived from the URI path. The data still goes through the hybrid SPARQL + S3 accessor.",
      "@id": "urn:solid-server:default:ResourceStore_Backend",
      "@type": "HonorUuidSlugDataAccessorBasedStore",
      "identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" },
      "auxiliaryStrategy": { "@id": "urn:solid-server:default:AuxiliaryStrategy" },
      "accessor": { "@id": "urn:sai:default:HybridDataAccessor" },
      "metadataStrategy": { "@id": "urn:solid-server:default:MetadataStrategy" },
      "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" }
    },
    {
      "@id": "urn:sai:default:HybridDataAccessor",
      "@type": "HybridDataAccessor",
      "binaryAccessor": { "@id": "urn:sai:default:RoutedS3DataAccessor" },
      "sparqlAccessor": { "@id": "urn:solid-server:default:SparqlDataAccessor" },
      "converter": { "@id": "urn:solid-server:default:RepresentationConverter" }
    },
    {
      "comment": "Per-data-pod object (S3) endpoint from the pod's objectEndpoint record — no shared/default bucket.",
      "@id": "urn:sai:default:RoutedS3DataAccessor",
      "@type": "RoutedS3DataAccessor",
      "storageStrategy": { "@id": "urn:solid-server:default:StorageLocationStrategy" },
      "endpointStore": { "@id": "urn:sai:default:PodEndpointStore" },
      "region": { "@id": "urn:sai:default:variable:s3Region" }
    }
  ]
}
