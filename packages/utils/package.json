  "files": ["dist/", "src/"],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "publish": "npm run clean && npm run build"
  },
  "dependencies": {
    "http-link-header": "^1.1.1",
    "jsonld": "^9.0.0",
    "n3": "^1.23.1",
    "postgres": "^3.4.7",
    "rdf-vocabulary": "^1.0.1"
  },
  "devDependencies": {
    "@rdfjs/types": "^1.1.0",
    "@types/http-link-header": "^1.0.3",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.21.1"
  }
}
