PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX shapetrees: <http://www.w3.org/ns/shapetrees#>
PREFIX solidshapes: <https://shapetrees.hackers4peace.net/shapes/>
PREFIX solidtrees: <https://shapetrees.hackers4peace.net/trees/>

solidtrees:File
  a shapetrees:ShapeTree ;
  shapetrees:expectsType shapetrees:NonRDFResource ;
  shapetrees:describesInstance skos:prefLabel .

solidtrees:desc-en\#File
  shapetrees:inDescriptionSet solidtrees:desc-en ;
  shapetrees:describes solidtrees:File .

solidtrees:desc-en
  shapetrees:usesLanguage "en"^^xsd:language .

solidtrees:desc-es\#File
  shapetrees:inDescriptionSet solidtrees:desc-es ;
  shapetrees:describes solidtrees:File .

solidtrees:desc-es
  shapetrees:usesLanguage "es"^^xsd:language .

solidtrees:desc-pl\#File
  shapetrees:inDescriptionSet solidtrees:desc-pl ;
  shapetrees:describes solidtrees:File .

solidtrees:desc-pl
  shapetrees:usesLanguage "pl"^^xsd:language .
